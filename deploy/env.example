# Secrets for the Trilium MCP server.
#
# Lives on the server next to the compose file, as `.env.trilium-notecast-mcp`,
# referenced from the service's `env_file:`. Never committed — the deploy never
# copies it, so the secrets stay on the server.
#
# Suggested ownership: root:docker, mode 640, so the admin user can read it
# without sudo. Note that membership in the `docker` group is equivalent to root
# anyway, so this grants nothing extra.

# ETAPI token: Trilium → Options → ETAPI → Create new token
TRILIUM_API_KEY=

# Clients must send: Authorization: Bearer <MCP_AUTH_TOKEN>
# Generate with: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
MCP_AUTH_TOKEN=

# Note ID new notes are created under when neither the call nor the type
# definition specifies a parent
TRILIUM_DEFAULT_PARENT=root

# There is deliberately no per-type pinning variable: a type is resolved by its
# #notecastType=<id> label, and two notes carrying the same id make the server
# refuse to pick one. See docs/notecast-contract.md.
